					<xs:documentation>Gen-Panel</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="tngs">
				<xs:annotation>
					<xs:documentation>Targeted NGS</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="fusion-detection-panel">
