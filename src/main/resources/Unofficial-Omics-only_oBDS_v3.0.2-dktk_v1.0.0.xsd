				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="rnaseq">
				<xs:annotation>
					<xs:documentation>RNA-Sequenzierung (RNA-Seq)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="wes">
