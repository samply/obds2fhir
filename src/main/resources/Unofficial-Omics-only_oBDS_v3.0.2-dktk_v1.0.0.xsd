	<xs:simpleType name="ICD_Version_Typ">
		<xs:annotation>
			<xs:documentation> ICD 10 Version 2006 WHO (gültig bis 2010), ICD 10 Version 2011 WHO
				(gültig bis 2012), ICD 10 Version 2013 WHO (gültig bis 2015), ICD 10 Version 2016
